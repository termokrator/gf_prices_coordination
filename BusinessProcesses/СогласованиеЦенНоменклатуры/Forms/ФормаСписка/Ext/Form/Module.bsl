&НаКлиенте
Процедура УдалитьНавсегда(Команда)
	
	ВыделенныеСтроки = Элементы.Список.ВыделенныеСтроки;
	Если ВыделенныеСтроки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	УдалитьНавсегдаНаСервере(ВыделенныеСтроки);
	Элементы.Список.Обновить();
	
КонецПроцедуры

&НаСервере
Процедура УдалитьНавсегдаНаСервере(Ссылки)
	
	СогласованиеЦенНоменклатурыСервер.УдалитьОбъектыНавсегда(Ссылки);
	
КонецПроцедуры
