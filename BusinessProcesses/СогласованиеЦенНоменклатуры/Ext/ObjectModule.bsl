
Процедура НачатьСогласованиеПередСтартом(ТочкаМаршрутаБизнесПроцесса, Отказ)
	
	Если Не ЗначениеЗаполнено(Номенклатура) Тогда
		Сообщить("Не заполнена номенклатура.");
		Отказ = Истина;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ДатаПрименения) Или НачалоДня(ДатаПрименения) < НачалоДня(ТекущаяДата()) Тогда
		Сообщить("Дата применения не может быть меньше текущей даты.");
		Отказ = Истина;
	КонецЕсли;
	
	Если Цены.Количество() = 0 Тогда
		Сообщить("Не заполнены цены для согласования.");
		Отказ = Истина;
	КонецЕсли;
	
	Для НомерСогласующего = 1 По 3 Цикл
		Если СогласованиеЦенНоменклатурыСервер.ПолучитьСогласующего(Номер) = Неопределено Тогда
			Сообщить("В регистре сведений ""Согласующие цен номенклатуры"" не заполнен согласующий " + Номер + ".");
			Отказ = Истина;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура Согласование1ПриСозданииЗадач(ТочкаМаршрутаБизнесПроцесса, ФормируемыеЗадачи, Отказ)
	
	ЗаполнитьИсполнителяЗадач(ФормируемыеЗадачи, 1, Отказ);
	
КонецПроцедуры

Процедура Согласование2ПриСозданииЗадач(ТочкаМаршрутаБизнесПроцесса, ФормируемыеЗадачи, Отказ)
	
	ЗаполнитьИсполнителяЗадач(ФормируемыеЗадачи, 2, Отказ);
	
КонецПроцедуры

Процедура Согласование3ПриСозданииЗадач(ТочкаМаршрутаБизнесПроцесса, ФормируемыеЗадачи, Отказ)
	
	ЗаполнитьИсполнителяЗадач(ФормируемыеЗадачи, 3, Отказ);
	
КонецПроцедуры

Процедура Согласование1ПередВыполнением(ТочкаМаршрутаБизнесПроцесса, Задача, Отказ)
	
	ПроверитьЧтоРешениеПринято(Задача, Отказ);
	
КонецПроцедуры

Процедура Согласование2ПередВыполнением(ТочкаМаршрутаБизнесПроцесса, Задача, Отказ)
	
	ПроверитьЧтоРешениеПринято(Задача, Отказ);
	
КонецПроцедуры

Процедура Согласование3ПередВыполнением(ТочкаМаршрутаБизнесПроцесса, Задача, Отказ)
	
	ПроверитьЧтоРешениеПринято(Задача, Отказ);
	
КонецПроцедуры

Процедура Согласование1ПриВыполнении(ТочкаМаршрутаБизнесПроцесса, Задача, Отказ)
	
	ЗафиксироватьРешение(1, Задача);
	
КонецПроцедуры

Процедура Согласование2ПриВыполнении(ТочкаМаршрутаБизнесПроцесса, Задача, Отказ)
	
	ЗафиксироватьРешение(2, Задача);
	
КонецПроцедуры

Процедура Согласование3ПриВыполнении(ТочкаМаршрутаБизнесПроцесса, Задача, Отказ)
	
	ЗафиксироватьРешение(3, Задача);
	Согласовано = Задача.Согласовано;
	Записать();
	
КонецПроцедуры

Процедура ЦеныСогласованыПроверкаУсловия(ТочкаМаршрутаБизнесПроцесса, Результат)
	
	Результат = Согласовано;
	
КонецПроцедуры

Процедура ПрименитьЦеныОбработка(ТочкаМаршрутаБизнесПроцесса)
	
	СогласованиеЦенНоменклатурыСервер.СоздатьДокументПоСогласованию(ЭтотОбъект);
	СогласованиеЦенНоменклатурыСервер.ОтправитьПисьмоОтделуПродаж(ЭтотОбъект);
	
КонецПроцедуры

Процедура ЗавершениеПриЗавершении(ТочкаМаршрутаБизнесПроцесса, Отказ)
	
	СогласованиеЦенНоменклатурыСервер.ОтправитьУведомлениеОРезультате(ЭтотОбъект);
	
КонецПроцедуры

Процедура ЗаполнитьИсполнителяЗадач(ФормируемыеЗадачи, Номер, Отказ)
	
	Согласующий = СогласованиеЦенНоменклатурыСервер.ПолучитьСогласующего(Номер);
	Если Согласующий = Неопределено Тогда
		Сообщить("Не заполнен согласующий " + Номер + ".");
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Для Каждого Задача Из ФормируемыеЗадачи Цикл
		Задача.Исполнитель = Согласующий.Пользователь;
		Задача.НомерСогласующего = Номер;
		Задача.Наименование = Лев("Согласование цен: " + Строка(Номенклатура) + " (согласующий " + Номер + ")", 150);
		Задача.Дата = ТекущаяДата();
	КонецЦикла;
	
КонецПроцедуры

Процедура ПроверитьЧтоРешениеПринято(Задача, Отказ)
	
	Если Не Задача.РешениеПринято Тогда
		Сообщить("Укажите результат в форме задачи: согласовать или отказать.");
		Отказ = Истина;
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗафиксироватьРешение(Номер, Задача)
	
	ЭтотОбъект["СогласованиеВыполнено" + Номер] = Истина;
	ЭтотОбъект["РезультатСогласования" + Номер] = Задача.Согласовано;
	ЭтотОбъект["Комментарий" + Номер] = Задача.Комментарий;
	ЭтотОбъект["ДатаРешения" + Номер] = ТекущаяДата();
	
	Если Номер < 3 Тогда
		Записать();
	КонецЕсли;
	
КонецПроцедуры
