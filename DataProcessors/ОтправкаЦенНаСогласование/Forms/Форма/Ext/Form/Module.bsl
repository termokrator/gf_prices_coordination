
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("Номенклатура") Тогда
		Объект.Номенклатура = Параметры.Номенклатура;
	КонецЕсли;
	
	Если Параметры.Свойство("ЦеныНоменклатуры") И Параметры.ЦеныНоменклатуры <> Неопределено Тогда
		ИсточникЦен = Параметры.ЦеныНоменклатуры;
		Если ТипЗнч(ИсточникЦен) <> Тип("ТаблицаЗначений") Тогда
			ИсточникЦен = ИсточникЦен.Выгрузить();
		КонецЕсли;
		Объект.ТаблицаЦен.Загрузить(ИсточникЦен);
	КонецЕсли;
	
	Для Каждого СтрокаЦен Из Объект.ТаблицаЦен Цикл
		СтрокаЦен.ЦенаСтарая = СтрокаЦен.Цена;
	КонецЦикла;
	
	СогласованиеЦенНоменклатурыСервер.ОставитьТипыЦенСогласования(Объект.ТаблицаЦен);
	
КонецПроцедуры

&НаКлиенте
Процедура ОК(Команда)
	
	ТекстОшибки = "";
	СсылкаПроцесса = Неопределено;
	Если Не НачатьСогласованиеНаСервере(СсылкаПроцесса, ТекстОшибки) Тогда
		Сообщить(ТекстОшибки);
		Возврат;
	КонецЕсли;
	
	Сообщить("Запущено согласование цен " + СсылкаПроцесса);
	Закрыть();
	
КонецПроцедуры

&НаКлиенте
Процедура Отмена(Команда)
	
	Закрыть();
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаЦенЦенаПриИзменении(Элемент)
	
	ПересчитатьОтКанала5();
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаЦенЦенаСНДСПриИзменении(Элемент)
	
	ТекущаяСтрока = Элементы.ТаблицаЦен.ТекущиеДанные;
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПересчитатьЦенуБезНДСНаСервере(ТекущаяСтрока.ПолучитьИдентификатор());
	ПересчитатьОтКанала5();
	
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьОтКанала5()
	
	ТекстОшибки = "";
	Если Не ПересчитатьОтКанала5НаСервере(ТекстОшибки) Тогда
		Сообщить(ТекстОшибки);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция НачатьСогласованиеНаСервере(СсылкаПроцесса, ТекстОшибки)
	
	Попытка
		СсылкаПроцесса = СогласованиеЦенНоменклатурыСервер.НачатьСогласование(
			Объект.Номенклатура,
			Объект.ДатаПрименения,
			Объект.ТаблицаЦен.Выгрузить());
	Исключение
		ТекстОшибки = ОписаниеОшибки();
		Возврат Ложь;
	КонецПопытки;
	
	Возврат Истина;
	
КонецФункции

&НаСервере
Процедура ПересчитатьЦенуБезНДСНаСервере(ИдентификаторСтроки)
	
	СтрокаЦен = Объект.ТаблицаЦен.НайтиПоИдентификатору(ИдентификаторСтроки);
	СтавкаНДСЧисло = УчетНДС.ПолучитьСтавкуНДС(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Номенклатура, "СтавкаНДС"));
	СтрокаЦен.Цена = СтрокаЦен.ЦенаСНДС / (1 + СтавкаНДСЧисло / 100);
	
КонецПроцедуры

&НаСервере
Функция ПересчитатьОтКанала5НаСервере(ТекстОшибки)
	
	Попытка
		Таблица = Объект.ТаблицаЦен.Выгрузить();
		СогласованиеЦенНоменклатурыСервер.ПересчитатьЦеныОтКанала5(Таблица, Объект.Номенклатура);
		Объект.ТаблицаЦен.Загрузить(Таблица);
	Исключение
		ТекстОшибки = ОписаниеОшибки();
		Возврат Ложь;
	КонецПопытки;
	
	Возврат Истина;
	
КонецФункции
